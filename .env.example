# =========================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# =========================================================

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg2://triage_user:triage_pass@localhost:5432/email_triage

# ---- Gmail API (OAuth 2.0) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the "Gmail API", create an OAuth Client ID (Desktop App type),
# download the JSON and save it as credentials/gmail_credentials.json
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json
# The mailbox that will be monitored for incoming triage emails
GMAIL_MONITORED_ACCOUNT=inbox@yourcompany.com

# ---- Department routing addresses ----
DEPT_SALES_EMAIL=sales@company.com
DEPT_SUPPORT_EMAIL=support@company.com
DEPT_BILLING_EMAIL=finance@company.com
DEPT_HR_EMAIL=hr@company.com
DEPT_IT_EMAIL=it@company.com
DEPT_LEGAL_EMAIL=legal@company.com
DEPT_COMPLAINT_EMAIL=escalations@company.com
DEPT_GENERAL_EMAIL=general@company.com

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000

# ---- Frontend ----
FRONTEND_PORT=8501

# ---- Email polling ----
# How often (seconds) the scheduler checks Gmail for new unread mail
POLL_INTERVAL_SECONDS=60
AUTO_ROUTING_ENABLED=true

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
